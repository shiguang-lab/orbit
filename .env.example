# Each deployable service uses its own image built from an explicit Dockerfile target.
# For a registry release, set all six variables to the same version/digest family.
SHIGUANG_GATEWAY_ADMIN_IMAGE=shiguang-gateway-admin:local
SHIGUANG_GATEWAY_EDGE_IMAGE=shiguang-gateway-edge:local
SHIGUANG_GATEWAY_CONTROL_IMAGE=shiguang-gateway-control:local
SHIGUANG_GATEWAY_REALTIME_IMAGE=shiguang-gateway-realtime:local
SHIGUANG_GATEWAY_WORKER_IMAGE=shiguang-gateway-worker:local
SHIGUANG_GATEWAY_IMPORTER_IMAGE=shiguang-gateway-importer:local
SHIGUANG_GATEWAY_EDGE_PORT=8787
SHIGUANG_GATEWAY_CONTROL_PORT=8788
SHIGUANG_GATEWAY_REALTIME_PORT=8790
SHIGUANG_GATEWAY_LIVE_WS_PORT=20132
SHIGUANG_GATEWAY_SOURCE_DATA_DIR=./source-data

# Secrets belong to this independent instance. Generate with `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-stable-random-secret
API_KEY_SECRET=replace-with-a-stable-random-secret
# Must remain stable when importing existing provider credentials.
STORAGE_ENCRYPTION_KEY=replace-with-a-stable-random-secret
PUBLIC_BASE_URL=http://127.0.0.1:8787
INTERNAL_BASE_URL=http://127.0.0.1:8787
SHIGUANG_GATEWAY_BASE_URL=http://127.0.0.1:8787

# shiguang SSO verification (required when the gateway is behind Access Gateway).
SG_IDENTITY_ISSUER=https://shiguanglab.com
SG_IDENTITY_AUDIENCE=shiguang-gateway-api
SG_IDENTITY_ENTITLEMENT=shiguang-gateway:access
SG_IDENTITY_JWKS_URL=https://shiguanglab.com/.well-known/sg-identity-jwks.json

# The independent gateway web may use unified shiguang SSO.
SHIGUANG_GATEWAY_AUTH_MODE=shiguang
VITE_AUTH_MODE=shiguang
