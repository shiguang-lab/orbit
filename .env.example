# GHCR image to deploy. Pin a version or commit tag for repeatable rollback.
ORBIT_GATEWAY_IMAGE=ghcr.io/shiguang-lab/orbit-gateway:latest
ORBIT_GATEWAY_PORT=8787

# Orbit's management API reachable from this container.
# Examples: http://orbit:20128 or http://192.168.1.20:20128
OMNIROUTE_NAS_API_TARGET=http://orbit:20128
OMNIROUTE_NAS_MANAGEMENT_API_KEY=replace-with-a-manage-scoped-key

# shiguang SSO verification (required when the gateway is behind Access Gateway).
SG_IDENTITY_ISSUER=https://shiguanglab.com
SG_IDENTITY_AUDIENCE=omniroute-api
SG_IDENTITY_ENTITLEMENT=omniroute:access
SG_IDENTITY_JWKS_URL=https://shiguanglab.com/.well-known/sg-identity-jwks.json
