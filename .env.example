# Each deployable service uses its own image built from an explicit Dockerfile target.
# For a registry release, set all six variables to the same version/digest family.
ORBIT_CONSOLE_IMAGE=orbit-console:local
ORBIT_GATEWAY_IMAGE=orbit-gateway:local
ORBIT_CONTROL_IMAGE=orbit-control:local
ORBIT_REALTIME_IMAGE=orbit-realtime:local
ORBIT_WORKER_IMAGE=orbit-worker:local
# Preserve the NAS reverse proxy's existing Web/API upstream port.
# Backend ports stay on the Docker network and are not published to the host.
ORBIT_CONSOLE_PORT=8787
ORBIT_SOURCE_DATA_DIR=./source-data

# Secrets belong to this independent instance. Generate with `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-stable-random-secret
API_KEY_SECRET=replace-with-a-stable-random-secret
# Public model endpoints require an existing gateway API key.
REQUIRE_API_KEY=true
# Must remain stable when importing existing provider credentials.
STORAGE_ENCRYPTION_KEY=replace-with-a-stable-random-secret
# Hourly by default. Standard five-field cron, evaluated in UTC.
ORBIT_LOG_EXPORT_CRON=0 * * * *
# Persisted A2A history retention window used by the orchestration canvas.
ORBIT_A2A_HISTORY_RETENTION_DAYS=30
# Set to 0 to disable observability-only memory recall metadata on A2A tasks.
ORBIT_A2A_MEMORY_HITS=1
PUBLIC_BASE_URL=https://ai.shiguanglab.com
ORBIT_BASE_URL=http://orbit-gateway:8787

# shiguang SSO verification (required when the gateway is behind Access Gateway).
SG_AUTH_ORIGIN=https://shiguanglab.com
SG_IDENTITY_ISSUER=https://shiguanglab.com
SG_IDENTITY_AUDIENCE=orbit-api
SG_IDENTITY_ENTITLEMENT=orbit:access
SG_IDENTITY_JWKS_URL=https://shiguanglab.com/.well-known/sg-identity-jwks.json

# The independent gateway web may use unified shiguang SSO.

# Enable the separately deployed NAS CLIProxyAPI instance and automatic registration.
# COMPOSE_PROFILES=node
ORBIT_CLIPROXY_MANAGER_IMAGE=orbit-cliproxy-manager:local
# ORBIT_CLIPROXY_MANAGER_ENDPOINT=http://orbit-cliproxy-manager:8792
ORBIT_CLIPROXY_MANAGER_ID=nas
ORBIT_CLIPROXY_MANAGER_NAME=NAS
# Data-plane key fallback; the persisted cliproxyapi_api_key setting takes precedence.
# CLIPROXYAPI_API_KEY=
