{
  "name": "@orbit/config",
  "version": "0.1.0",
  "description": "Environment configuration contracts shared by deployable applications",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./timeouts": {
      "types": "./src/timeouts.ts",
      "import": "./src/timeouts.ts"
    },
    "./dataPaths": {
      "types": "./src/dataPaths.ts",
      "import": "./src/dataPaths.ts"
    },
    "./oauth": {
      "types": "./src/oauth.ts",
      "import": "./src/oauth.ts"
    },
    "./cli/model-profile": {
      "types": "./types/model-profile.d.ts",
      "import": "./src/cli/model-profile.mjs"
    },
    "./cli/codex": {
      "types": "./types/codex.d.ts",
      "import": "./src/cli/codex.mjs"
    },
    "./cli/claude": {
      "types": "./types/claude.d.ts",
      "import": "./src/cli/claude.mjs"
    },
    "./logEnv": {
      "types": "./src/logEnv.ts",
      "import": "./src/logEnv.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
