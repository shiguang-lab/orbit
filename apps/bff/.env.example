# @omniroute/bff 环境变量参考
# 完整说明见 deploy/SSO-INTEGRATION.md

# ── shiguang 统一身份(JWKS 校验, 生产) ──
SG_IDENTITY_ISSUER=https://shiguanglab.com
SG_IDENTITY_AUDIENCE=omniroute-api
SG_IDENTITY_ENTITLEMENT=omniroute:access
SG_IDENTITY_JWKS_URL=https://shiguanglab.com/.well-known/sg-identity-jwks.json
# SG_IDENTITY_JWKS_FILE=

# ── 本地 SSO Broker(asset-hub 同款: 真实 shiguang 账号换身份) ──
# 显式开启后本地开发走线上 SSO 身份；线上未配 omniroute 产品策略时返回 broker 错误
# 前提: 线上 auth-service 需 LOCAL_BROKER_ENABLED=true 且 LOCAL_BROKER_POLICIES 含 omniroute
#       (见 deploy/auth-service-config.md)
# SG_LOCAL_BROKER_ENABLED=false
# SG_BROKER_AUTH_TARGET=https://shiguanglab.com
# SG_BROKER_USERNAME=your-real-shiguang-login
# SG_BROKER_PASSWORD=your-real-shiguang-password

# ── 本地开发身份(生产绝不可用) ──
# dev 启动脚本默认设置 SG_DEV_IDENTITY=1；也可显式设置
# SG_DEV_IDENTITY=1

# ── 本地管理台 → NAS 业务 API ──
# 本地只运行 admin + BFF；Provider、首页统计、设置和写操作均由 NAS Orbit 提供。
# 仅允许开发环境 loopback BFF 使用；未设置时才使用同机 Orbit 引擎（生产形态）。
# OMNIROUTE_NAS_API_TARGET=http://100.87.115.78:20128
# 服务端管理 API Key（必须是 NAS 上具有 manage/admin scope 的 key；不写入前端）。
# OMNIROUTE_NAS_MANAGEMENT_API_KEY=
# 可选：远端请求超时（毫秒）。
# OMNIROUTE_NAS_API_TIMEOUT_MS=30000

# ── 服务 ──
BFF_PORT=8787
BFF_HOST=127.0.0.1
LOG_LEVEL=info

# ── 同机引擎(SQLite 数据，仅未配置 NAS target 时使用) ──
# DATA_DIR=/path/to/orbit-data
# SQLITE_FILE=/path/to/orbit/storage.sqlite
