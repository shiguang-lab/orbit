{
  "name": "@orbit/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development SG_DEV_IDENTITY=1 tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "tsx --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@orbit/auth": "workspace:*",
    "@orbit/contracts": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/http": "workspace:*",
    "@orbit/inference": "workspace:*",
    "fastify": "catalog:",
    "jose": "^6.2.10",
    "tsx": "^4.23.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:"
  }
}
