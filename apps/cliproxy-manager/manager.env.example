# Create a node in Orbit > Service nodes and copy its one-time credentials here.
CLIPROXY_MANAGER_ID=nas
CLIPROXY_MANAGER_NAME=NAS
CLIPROXY_MANAGER_REPORT_URL=http://orbit-control:8788/internal/service-nodes/nas/report
CLIPROXY_MANAGER_DATA_DIR=/data
CLIPROXY_MANAGER_LISTEN=0.0.0.0:8792
CLIPROXY_MANAGER_INTERVAL=15s
