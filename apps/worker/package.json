{
  "name": "@orbit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development SG_DEV_IDENTITY=1 tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "tsx --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@orbit/auth": "workspace:*",
    "@orbit/contracts": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/inference": "workspace:*",
    "@orbit/providers": "workspace:*",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.13",
    "undici": "^8.10.1",
    "@orbit/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
