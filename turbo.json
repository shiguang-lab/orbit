{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "16",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_UNIFIED_LOGIN_ORIGIN"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
