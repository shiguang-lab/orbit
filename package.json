{
  "name": "orbit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "fastify": "5.12.1"
    }
  },
  "scripts": {
    "cli": "pnpm --filter @orbit/cli exec node src/orbit.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test:scoped": "bash scripts/quality/test-scoped.sh",
    "test:scoped:staged": "bash scripts/quality/test-scoped.sh --staged",
    "test:scoped:full": "bash scripts/quality/test-scoped.sh --full",
    "quality:complexity": "node scripts/check/check-complexity-ratchets.mjs",
    "quality:dead-code": "node scripts/check/check-dead-code.mjs",
    "release:reconcile": "node scripts/release/reconcile-changelog.mjs",
    "audit:gateway-independence": "node scripts/audit-gateway-independence.mjs --strict",
    "audit:brand": "node scripts/audit-brand-independence.mjs",
    "audit:console-routes": "node scripts/audit-console-routes.mjs --strict",
    "audit:route-contracts": "node scripts/audit-route-contracts.mjs --strict",
    "audit:app-boundaries": "node scripts/audit-app-boundaries.mjs --strict",
    "audit:architecture": "node scripts/audit-architecture.mjs --strict",
    "audit:package-boundaries": "node scripts/audit-package-boundaries.mjs --strict",
    "audit:cli-paths": "node scripts/audit-cli-path-contracts.mjs",
    "audit:db-entities": "node scripts/audit-db-entities.mjs",
    "audit:db-schema-coverage": "node scripts/audit-db-schema-coverage.mjs",
    "audit:inference-boundary": "node scripts/audit-inference-boundary.mjs --strict",
    "verify:external-state": "node scripts/verify-external-state.mjs",
    "audit:provider-config": "node scripts/audit-provider-config.mjs",
    "verify:release": "pnpm --filter @orbit/cliproxy-manager test && pnpm --filter @orbit/control exec tsx --test test/service-nodes.test.ts && node --test scripts/ops/import-cliproxy.test.mjs && pnpm audit:gateway-independence && pnpm audit:route-contracts && pnpm audit:brand && pnpm --filter @orbit/console test && pnpm --filter @orbit/auth test && pnpm --filter @orbit/realtime test && pnpm --filter @orbit/utils test && pnpm --filter @orbit/http test && pnpm --filter @orbit/control exec node --import tsx --test ../../packages/http/test/web-request.test.ts && pnpm --filter @orbit/control exec node --import tsx --test test/settings-import-request.test.ts && pnpm --filter @orbit/control exec node --import tsx --test test/auth-session.test.ts test/combo-runtime-registration.test.ts && pnpm --filter @orbit/gateway exec tsx --test test/dispatcher-module-injection.test.ts && pnpm smoke:route-imports && pnpm smoke:split-deployment && node --test scripts/smoke-worker-start.test.mjs && node --test scripts/compose-auth-contract.test.mjs && pnpm smoke:worker && pnpm smoke:agent-skills",
    "smoke:provider-matrix": "node scripts/smoke-provider-matrix.mjs",
    "smoke:split-deployment": "node scripts/smoke-split-deployment.mjs",
    "smoke:worker": "node scripts/smoke-worker-start.mjs",
    "smoke:container-deployment": "node scripts/smoke-container-deployment.mjs",
    "smoke:agent-skills": "pnpm --filter @orbit/core exec tsx --tsconfig tsconfig.json ../../scripts/smoke-agent-skills.mjs",
    "smoke:route-imports": "node --test scripts/smoke-route-imports.test.mjs && pnpm --filter @orbit/control exec tsx --tsconfig ../../scripts/tsconfig.route-imports.json ../../scripts/smoke-route-imports.mjs",
    "dev:console": "pnpm --filter @orbit/console dev",
    "dev:edge": "pnpm --filter @orbit/gateway dev",
    "dev:control": "pnpm --filter @orbit/control dev",
    "dev:realtime": "pnpm --filter @orbit/realtime dev",
    "dev:worker": "pnpm --filter @orbit/worker dev",
    "start:edge": "pnpm --filter @orbit/gateway start",
    "start:control": "pnpm --filter @orbit/control start",
    "start:realtime": "pnpm --filter @orbit/realtime start",
    "start:worker": "pnpm --filter @orbit/worker start",
    "dev:cliproxy-manager": "pnpm --filter @orbit/cliproxy-manager dev",
    "test:cliproxy-manager": "pnpm --filter @orbit/cliproxy-manager test",
    "smoke:cliproxy-manager": "node scripts/smoke-cliproxy-manager.mjs"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "~5.8.0"
  }
}
